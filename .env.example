# Domínio principal da plataforma SaaS (sem https://)
# Em desenvolvimento local, use localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_PLATFORM_NAME=Nocaute Hub
NEXT_PUBLIC_SALES_WHATSAPP=

# Supabase (deixe vazio para rodar em modo local; preencha quando criar o projeto)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Credenciais do Painel Master (usadas no modo local antes de conectar o Supabase Auth)
MASTER_ADMIN_EMAIL=admin@nocautehub.com.br
MASTER_ADMIN_PASSWORD=nocaute123

# Cloudflare for SaaS (opcional - para automação real de Custom Hostnames)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
NEXT_PUBLIC_CLOUDFLARE_CNAME_TARGET=cname.nocautehub.com

# Cobrança Recorrente / Webhooks (Asaas, Mercado Pago ou Stripe)
BILLING_WEBHOOK_SECRET=
